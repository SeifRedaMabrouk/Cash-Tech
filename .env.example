# العنوان الحقيقي للموقع بدون / في الآخر. لازم يطابق اللي الزوار بيفتحوه (https).
# لو الموقع بيفتح بـ www وبدونها، اختار واحد هنا والتاني هيتحول له تلقائيًا.
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
# مجلد دائم: قاعدة البيانات والصور. على الاستضافة لازم يكون على قرص/Volume ثابت وإلا البيانات هتضيع.
DATA_DIR=./data
SEED_DEMO=0
# عدد الـ reverse proxies الموثوقة أمام Node (nginx/Cloudflare/منصة الاستضافة). 0 = لا تثق في X-Forwarded-For.
# على أي استضافة فيها بروكسي (تقريبًا كلها) اضبطه على 1، وإلا محاولات دخول غلط من أي حد ممكن تقفل الدخول عليك.
TRUST_PROXY=0
